# Required if using a real LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_MAX_TOKENS=16384
REASONING_BUDGET=16384
INPUT_COST_PER_MILLION=0.0
OUTPUT_COST_PER_MILLION=0.0

# Optional tracing providers
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab
LANGFUSE_PUBLIC_KEY=pk-lf-local-research-2026
LANGFUSE_SECRET_KEY=sk-lf-local-research-2026-change-me
LANGFUSE_HOST=http://localhost:3001
# Set both keys to send spans to Langfuse; otherwise local state.trace is used.

# Optional search provider
TAVILY_API_KEY=

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
